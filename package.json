{
  "name": "reparticle",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @reparticle/demo^... build && pnpm --filter @reparticle/demo dev",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@reparticle/pixi",
    "test": "playwright install chromium && turbo run test",
    "test:webgpu": "playwright install chromium && turbo run test:webgpu",
    "typecheck": "turbo run typecheck",
    "lint": "pnpm build:packages && oxlint .",
    "format": "oxfmt .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format:check": "oxfmt --check .",
    "dev:site": "pnpm --filter @reparticle/site^... build && pnpm --filter @reparticle/site dev",
    "prepare": "husky",
    "precommit": "pnpm build:packages && lint-staged",
    "prepush": "pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "release:version": "changeset version && pnpm install --lockfile-only --ignore-scripts && oxfmt packages/*/CHANGELOG.md",
    "packages:check": "tsc -p scripts/tsconfig.json && node scripts/check-packed-consumer.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "26.6.5",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript/lib-dom": "npm:@types/web@0.0.359",
    "@typescript/native": "catalog:",
    "@vitest/browser-playwright": "4.1.10",
    "eslint-plugin-import-x": "catalog:",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "playwright": "1.58.2",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxfmt --check --no-error-on-unmatched-pattern",
      "oxlint"
    ],
    "*.{json,jsonc,yaml,yml,md,mdx,html,css,scss,less,vue,astro}": "oxfmt --check --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1"
}

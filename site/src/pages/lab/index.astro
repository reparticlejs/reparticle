---
import Catalog from '../../layouts/catalog.astro';
import { labProperties as properties, propertyId } from '../../content/properties';
import { propertyTitle } from '../../utils/property-title';
const groups = [...new Set(properties.map((property) => property.group))];
const base = import.meta.env.BASE_URL;
---
<Catalog title="Lab" description="Explore particle behavior one experiment at a time. Change values, drag curves, and see the result beside the controls. Open the JSON when you want to use it in your own effect.">
  <nav class="mb-8 flex flex-wrap gap-x-4 gap-y-2 text-xs text-muted-foreground" aria-label="Experiment categories">{groups.map((group) => <a class="hover:text-foreground" href={`#${group.replaceAll(' ', '-')}`}>{group}</a>)}</nav>
  {groups.map((group) => <section class="mt-12 scroll-mt-20" id={group.replaceAll(' ', '-')}>
    <h2 class="mb-4 text-xs font-semibold uppercase tracking-[0.14em] text-muted-foreground">{group}</h2><div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {properties.filter((property) => property.group === group).map((property) => <a class="group rounded-xl border bg-card p-5 transition-all hover:-translate-y-0.5 hover:border-foreground/30" href={`${base}lab/${propertyId(property)}/`}><div class="font-mono text-[11px] text-brand">{String(properties.indexOf(property) + 1).padStart(2, '0')}</div><h3 class="mt-1.5 font-semibold">{propertyTitle(property)}</h3><p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{property.description}</p></a>)}
    </div>
  </section>)}
</Catalog>

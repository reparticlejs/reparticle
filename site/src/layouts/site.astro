---
import '../styles/main.css';
import Logo from '../assets/brand/reparticle-horizontal.svg';
import favicon from '../assets/brand/reparticle-symbol.svg?url';
import { documentation, reference } from '../content/navigation';
import { labProperties, propertyId } from '../content/properties';
import { propertyTitle } from '../utils/property-title';
import { version } from '../../../packages/core/package.json';
import inter from '../assets/fonts/Inter-400.woff?url';

interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const sections = [['docs/', 'Docs'], ['api/', 'API'], ['lab/', 'Lab'], ['examples/', 'Examples']];
const searchLinks = [
  ...documentation.flatMap((group) => group.links),
  ...reference.flatMap((group) => group.links.map((link) => ({ ...link, description: 'API reference' }))),
  ...labProperties.map((property) => ({ path: `lab/${propertyId(property)}/`, title: `${property.group}: ${propertyTitle(property)}`, description: property.description })),
];
const footer = [
  { title: 'Learn', links: [['Introduction', 'docs/introduction/'], ['Quick start', 'docs/quick-start/'], ['Concepts', 'docs/concepts/']] },
  { title: 'Reference', links: [['Core', 'api/core/'], ['Pixi', 'api/pixi/']] },
  { title: 'Play', links: [['Lab', 'lab/'], ['Examples', 'examples/']] },
  { title: 'Project', links: [['Development', 'docs/development/']] },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{title}</title>
    <script is:inline>
      // Follow the system until a preference is saved; apply before first paint.
      let preference = 'system';
      try { preference = localStorage.getItem('reparticle-theme') ?? 'system'; } catch {}
      const dark = preference === 'dark' || (preference !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', dark);
    </script>
    <link rel="preload" href={inter} as="font" type="font/woff" crossorigin />
  </head>
  <body class="min-h-screen font-sans">
    <a href="#content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2">Skip to content</a>
    <header class="glass sticky top-0 z-40 border-b">
      <div class="container-page flex h-14 items-center gap-3 sm:gap-4">
        <div class="flex items-center gap-2">
          <a href={base} aria-label="reparticle home" class="flex shrink-0 items-center"><Logo class="site-logo" aria-hidden="true" /></a>
          <span class="site-version rounded-full border px-2 py-0.5 font-mono text-[11px] text-muted-foreground">v{version}</span>
        </div>
        <nav aria-label="Main navigation" class="ml-4 hidden items-center gap-1 md:flex">
          {sections.map(([path, label]) => <a href={`${base}${path}`} aria-current={Astro.url.pathname.startsWith(`${base}${path}`) ? 'page' : undefined} class:list={['rounded-md px-3 py-1.5 text-sm transition-colors', Astro.url.pathname.startsWith(`${base}${path}`) ? 'bg-accent text-foreground' : 'text-muted-foreground hover:text-foreground']}>{label}</a>)}
        </nav>
        <div class="ml-auto flex shrink-0 items-center gap-1">
          <button id="search-open" type="button" aria-label="Search documentation" class="inline-flex h-9 items-center gap-2 rounded-md border px-2.5 text-sm text-muted-foreground transition-colors hover:text-foreground sm:w-56">
            <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="2" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg>
            <span class="hidden sm:inline">Search docs</span><kbd class="ml-auto hidden rounded border px-1.5 font-mono text-[10px] sm:inline">⌘K</kbd>
          </button>
          <button id="theme-preference" data-preference="system" type="button" aria-label="Theme: system. Switch to light." class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-accent hover:text-foreground">
            <svg data-theme-icon="system" viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M12 17v4m-4 0h8"/></svg>
            <svg viewBox="0 0 24 24" data-theme-icon="dark" class="size-4 fill-none stroke-current" stroke-width="2" aria-hidden="true"><path d="M20 14a8.5 8.5 0 0 1-10-10 8.5 8.5 0 1 0 10 10Z"/></svg>
            <svg viewBox="0 0 24 24" data-theme-icon="light" class="size-4 fill-none stroke-current" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l2 2m10 10 2 2M5 19l2-2M17 7l2-2"/></svg>
          </button>
          <a href="https://github.com/reparticlejs/reparticle" aria-label="GitHub repository" class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground">
            <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.4-5.26 5.68.41.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          </a>
          <button id="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile" class="inline-flex size-9 items-center justify-center rounded-md text-muted-foreground hover:bg-accent md:hidden"><svg class="size-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        </div>
      </div>
      <nav id="nav-mobile" aria-label="Mobile navigation" class="hidden max-h-[calc(100dvh-3.5rem)] overflow-y-auto border-t px-4 py-3 md:hidden">
        {sections.map(([path, label]) => <a href={`${base}${path}`} aria-current={Astro.url.pathname.startsWith(`${base}${path}`) ? 'page' : undefined} class="block rounded-md px-3 py-3 text-sm text-muted-foreground hover:bg-accent hover:text-foreground aria-[current=page]:bg-accent aria-[current=page]:text-foreground">{label}</a>)}
      </nav>
    </header>
    <dialog id="site-search" aria-label="Search documentation" class="fixed inset-x-4 top-[12vh] m-0 mx-auto w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-xl border bg-card p-0 text-foreground shadow-2xl backdrop:bg-black/60 backdrop:backdrop-blur-sm">
      <div class="flex items-center border-b"><input id="search-query" type="search" placeholder="Search docs, API, and experiments…" aria-label="Search query" class="min-w-0 flex-1 bg-transparent px-4 py-3 text-base outline-none"/><form method="dialog"><button aria-label="Close search" class="mr-3 rounded border px-2 py-1 text-xs text-muted-foreground">Esc</button></form></div>
      <div class="max-h-[55vh] overflow-y-auto p-2 text-sm">{searchLinks.map((link) => <a href={`${base}${link.path}`} data-search-result class="block rounded-md p-3 hover:bg-accent"><strong class="block font-semibold">{link.title}</strong><span class="mt-1 block text-muted-foreground">{link.description}</span></a>)}</div>
      <p id="search-empty" class="p-4 text-sm text-muted-foreground" hidden>No matching pages.</p>
    </dialog>
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/code-copy.ts"></script>
    <main id="content" class="pt-6 md:pt-10"><slot /></main>
    <footer class="mt-24 border-t">
      <div class="container-page grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_repeat(4,1fr)]">
        <div><div class="font-semibold">reparticle</div><p class="mt-2 max-w-xs text-sm text-muted-foreground">GPU particle effects defined in JSON. PixiJS is our first and primary renderer.</p></div>
        {footer.map((column) => <div><div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">{column.title}</div><ul class="mt-3 space-y-2 text-sm">{column.links.map(([label, path]) => <li><a href={`${base}${path}`} class="text-foreground/80 hover:text-foreground">{label}</a></li>)}</ul></div>)}
      </div>
      <div class="container-page flex flex-wrap justify-between gap-2 border-t py-6 text-xs text-muted-foreground"><span>MIT licensed.</span><span>Built with Astro, React and PixiJS.</span></div>
    </footer>
  </body>
</html>

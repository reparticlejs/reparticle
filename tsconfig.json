{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "#examples/*": ["./examples/shared/public/*"],
      "#effect-example": ["./site/src/content/effect.example.json"]
    }
  },
  "include": [
    "packages/*/src",
    "examples/*/src",
    "packages/*/tests",
    "examples/*/tests",
    "site/src",
    "site/tests"
  ]
}

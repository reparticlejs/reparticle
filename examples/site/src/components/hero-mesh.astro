---
// Static layout: Astro calculates the edges at build time; the browser only paints CSS.
const nodes = [
  [30, 180, 5], [120, 70, 7], [150, 300, 6], [245, 160, 4],
  [280, 400, 7], [350, 40, 5], [390, 270, 8], [470, 140, 6],
  [510, 440, 5], [600, 50, 8], [620, 320, 6], [730, 190, 7],
  [770, 450, 8], [860, 80, 5], [880, 330, 6],
];
const connections = [
  [0, 1], [0, 2], [0, 3], [1, 3], [1, 5], [2, 3], [2, 4], [2, 6],
  [3, 5], [3, 6], [3, 7], [4, 6], [4, 8], [5, 7], [5, 9],
  [6, 7], [6, 8], [6, 10], [7, 9], [7, 10], [7, 11], [8, 10],
  [8, 12], [9, 11], [9, 13], [10, 11], [10, 12], [10, 14],
  [11, 13], [11, 14], [12, 14], [13, 14],
];
// Join neighboring sections before drawing, including their horizontal and vertical seams.
const fieldNodes = Array.from({ length: 9 }, (_, tile) =>
  nodes.map(([x, y, size]) => [x + (tile % 3) * 920, y + Math.floor(tile / 3) * 500, size]),
).flat();
const fieldConnections = Array.from({ length: 9 }, (_, tile) => {
  const offset = tile * nodes.length;
  const links = connections.map(([from, to]) => [offset + from, offset + to]);
  if (tile % 3 < 2) {
    for (const [from, to] of [[13, 1], [13, 0], [14, 0], [14, 2], [12, 2]]) {
      links.push([offset + from, offset + nodes.length + to]);
    }
  }
  if (tile < 6) {
    for (const [from, to] of [[4, 1], [4, 5], [8, 5], [8, 9], [12, 9], [12, 13]]) {
      links.push([offset + from, offset + 3 * nodes.length + to]);
    }
  }
  return links;
}).flat();
const edges = fieldConnections.map(([from, to]) => {
  const [x, y] = fieldNodes[from];
  const [endX, endY] = fieldNodes[to];
  return { x, y, length: Math.hypot(endX - x, endY - y), angle: Math.atan2(endY - y, endX - x) };
});
---
<div class="hero-mesh" aria-hidden="true">
  <div class="mesh-field">
    {edges.map(({ x, y, length, angle }) => <span class="mesh-edge" style={`left:${x}px;top:${y}px;width:${length}px;transform:rotate(${angle}rad)`} />)}
    {fieldNodes.map(([x, y, size]) => <span class="mesh-node" style={`left:${x}px;top:${y}px;width:${size}px;height:${size}px`} />)}
  </div>
</div>
<style>
  .hero-mesh {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mask-image: radial-gradient(ellipse at center, #000 25%, transparent 85%);
  }
  .mesh-field {
    position: absolute;
    left: 50%;
    top: 0;
    width: 2760px;
    height: 1500px;
    transform: translateX(-50%);
  }
  .mesh-edge {
    position: absolute;
    height: 1px;
    background: hsl(var(--brand) / 0.09);
    transform-origin: left center;
  }
  .mesh-node {
    position: absolute;
    border-radius: 50%;
    background: hsl(var(--brand) / 0.2);
    transform: translate(-50%, -50%);
  }
  @media (max-width: 767px) {
    .hero-mesh { opacity: 0.6; }
  }
</style>

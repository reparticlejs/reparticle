---
interface Props {
  groups: { title: string; links: { title: string; path: string }[] }[];
}
const { groups } = Astro.props;
const base = import.meta.env.BASE_URL;
const pathname = `${Astro.url.pathname.replace(/\/$/, '')}/`;
const current = groups.flatMap((group) => group.links).find((link) => pathname === `${base}${link.path}`);
---
<!-- Layout and spacing adapted from pixi-silk's DocsSidebar. -->
<aside class="md:sticky md:top-20 md:max-h-[calc(100vh-6rem)] md:self-start md:overflow-y-auto md:pb-8">
  <details class="group md:hidden">
    <summary class="cursor-pointer rounded-md border px-3 py-3 text-sm">{current?.title ?? 'Menu'}</summary>
    <nav aria-label="Page navigation" class="mt-2 max-h-[60dvh] space-y-4 overflow-y-auto text-sm">
      {groups.map((group) => <div>
        <div class="mb-1 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">{group.title}</div>
        {group.links.map((link) => <a href={`${base}${link.path}`} class="block py-3 text-muted-foreground hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground" aria-current={pathname === `${base}${link.path}` ? 'page' : undefined}>{link.title}</a>)}
      </div>)}
    </nav>
  </details>
  <nav aria-label="Page navigation" class="hidden text-sm md:block">
    {groups.map((group) => <div class="mb-6">
      <div class="mb-2 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">{group.title}</div>
      <ul class="space-y-0.5 border-l">
        {group.links.map((link) => <li>
          <a href={`${base}${link.path}`} aria-current={pathname === `${base}${link.path}` ? 'page' : undefined} class:list={[
            '-ml-px block border-l py-1 pl-3 transition-colors',
            pathname === `${base}${link.path}` ? 'border-brand font-medium text-foreground' : 'border-transparent text-muted-foreground hover:border-foreground/30 hover:text-foreground',
          ]}>{link.title}</a>
        </li>)}
      </ul>
    </div>)}
  </nav>
</aside>

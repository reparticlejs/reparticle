{
  "name": "@reparticle/pixi",
  "version": "0.1.0",
  "description": "PixiJS renderer for the reparticle GPU particle engine.",
  "homepage": "https://github.com/reparticlejs/reparticle#readme",
  "bugs": {
    "url": "https://github.com/reparticlejs/reparticle/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reparticlejs/reparticle.git",
    "directory": "packages/pixi"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#config/*": "./src/config/*",
    "#curves/*": "./src/curves/*",
    "#rendering/*": "./src/rendering/*",
    "#runtime/*": "./src/runtime/*",
    "#shaders/*": "./src/shaders/*",
    "#textures/*": "./src/textures/*",
    "#types/*": "./src/types/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@reparticle/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.1.10",
    "pixi.js": "catalog:",
    "playwright": "1.58.2",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "pixi.js": "^8.22.0"
  }
}

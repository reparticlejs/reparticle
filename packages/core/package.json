{
  "name": "@reparticle/core",
  "version": "0.1.0",
  "description": "GPU particle engine with JSON-defined effects.",
  "homepage": "https://github.com/reparticlejs/reparticle#readme",
  "bugs": {
    "url": "https://github.com/reparticlejs/reparticle/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reparticlejs/reparticle.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#config/*": "./src/config/*",
    "#curves/*": "./src/curves/*",
    "#runtime/*": "./src/runtime/*",
    "#simulation/*": "./src/simulation/*",
    "#types/*": "./src/types/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webgl2": {
      "types": "./dist/webgl2.d.ts",
      "import": "./dist/webgl2.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu.d.ts",
      "import": "./dist/webgpu.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm build:shaders && tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "pnpm build",
    "build:shaders": "node scripts/build-shaders.ts",
    "prepublishOnly": "pnpm --workspace-root check"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@typegpu/gl": "0.12.8",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "1.58.2",
    "tsdown": "catalog:",
    "typegpu": "0.12.9",
    "typescript": "catalog:",
    "unplugin-typegpu": "0.12.7",
    "vitest": "catalog:"
  }
}

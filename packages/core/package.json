{
  "name": "@reparticle/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#types/*": "./src/types/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:functions && tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run tests",
    "build:functions": "node scripts/build-functions.ts"
  },
  "dependencies": {
    "gpu.js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}

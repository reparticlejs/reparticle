{
  "tasks": {
    "build": {
      "env": ["SITE_URL", "SITE_BASE"],
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@reparticle/core#test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "@reparticle/pixi#test": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
